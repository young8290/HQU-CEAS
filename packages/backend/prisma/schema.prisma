// Prisma Schema for 综测管理系统
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("monitor") // "admin" | "monitor" | "reviewer"
  classId      Int?     @map("class_id")
  displayName  String?  @map("display_name")
  email        String?
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  class       Class?       @relation(fields: [classId], references: [id], onDelete: SetNull)
  scores      Score[]      @relation("UpdatedBy")
  scoreBonusDetails ScoreBonusDetail[] @relation("ScoreBonusDetailUpdatedBy")
  importLogs  ImportLog[]
  submittedDeclarations DeclarationBatch[] @relation("DeclarationSubmittedBy")
  reviewedDeclarations  DeclarationBatch[] @relation("DeclarationReviewedBy")
  checkedItems          DeclarationChecklistItem[] @relation("ChecklistCheckedBy")
  agreementSignatures   AgreementSignature[] @relation("AgreementSignedBy")
  storedFiles           StoredFile[] @relation("StoredFileCreatedBy")
  signatureFiles        SignatureFile[] @relation("SignatureFileCreatedBy")
  generatedPdfs         PdfFile[] @relation("PdfGeneratedBy")
  auditLogs             AuditLog[] @relation("AuditLogActor")
  mailConfigs           MailConfig[] @relation("MailConfigUpdatedBy")
  mailTemplates         MailTemplate[] @relation("MailTemplateUpdatedBy")
  mailLogs              MailLog[] @relation("MailLogSentBy")
  createdScoreReviewInvites ScoreReviewMemberInvite[] @relation("ScoreReviewInviteCreatedBy")
  reviewerScoreReviewInvites ScoreReviewMemberInvite[] @relation("ScoreReviewInviteReviewer")

  @@map("users")
}

model Grade {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  classes Class[]

  @@map("grades")
}

model Class {
  id        Int      @id @default(autoincrement())
  gradeId   Int      @map("grade_id")
  name      String
  studentGroupType String @default("regular") @map("student_group_type")
  isComputerCategory Boolean @default(false) @map("is_computer_category")
  createdAt DateTime @default(now()) @map("created_at")

  grade    Grade     @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  students Student[]
  users    User[]
  awardQuotas AwardQuota[]
  classHonorRecords ClassHonorRecord[]
  declarationBatches DeclarationBatch[]
  scoreReviewRecords ScoreReviewRecord[]
  tags Tag[]

  @@unique([gradeId, name])
  @@map("classes")
}

model Student {
  id        Int      @id @default(autoincrement())
  studentNo String   @unique @map("student_no")
  name      String
  classId   Int      @map("class_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  class  Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  scores Score[]
  externalAwardRecords ExternalAwardRecord[]
  declarationStudents DeclarationStudent[]
  declarationSupplements DeclarationSupplement[]
  tags Tag[]
  scoreReviewStudentChecks ScoreReviewStudentCheck[]
  nationalScholarshipCandidates NationalScholarshipCandidate[]

  @@map("students")
}

model AcademicYear {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isCurrent Boolean  @default(false) @map("is_current")
  createdAt DateTime @default(now()) @map("created_at")

  scores Score[]
  importLogs ImportLog[]
  externalAwardRecords ExternalAwardRecord[]
  awardQuotas AwardQuota[]
  classHonorRecords ClassHonorRecord[]
  declarationBatches DeclarationBatch[]
  declarationSupplements DeclarationSupplement[]
  scoreReviewRecords ScoreReviewRecord[]
  tags Tag[]
  nationalScholarshipEvaluations NationalScholarshipEvaluation[]

  @@map("academic_years")
}

model Score {
  id             Int      @id @default(autoincrement())
  studentId      Int      @map("student_id")
  academicYearId Int      @map("academic_year_id")
  category       String   // moral, academic, innovation, sports_base, sports_reward, sports_total, aesthetics, labor, public_service, bonus, total
  value          Float    @default(0)
  remark         String?
  updatedBy      Int?     @map("updated_by")
  updatedAt      DateTime @updatedAt @map("updated_at")

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  updatedByUser User?       @relation("UpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  bonusDetails  ScoreBonusDetail[]

  @@unique([studentId, academicYearId, category])
  // 排名/汇总高频谓词（PLAN_V2 §5.5）；由编排者统一 db push 落库
  @@index([academicYearId, category])
  @@map("scores")
}

model ScoreBonusDetail {
  id Int @id @default(autoincrement())
  scoreId Int @map("score_id")
  itemName String @map("item_name")
  itemScore Float @map("item_score")
  sortOrder Int @default(0) @map("sort_order")
  updatedBy Int? @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  score Score @relation(fields: [scoreId], references: [id], onDelete: Cascade)
  updatedByUser User? @relation("ScoreBonusDetailUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@unique([scoreId, sortOrder])
  @@index([scoreId])
  @@map("score_bonus_details")
}

model ImportLog {
  id           Int      @id @default(autoincrement())
  type         String   // academic, sports, personal_form
  filename     String?
  academicYearId Int?   @map("academic_year_id")
  sourceType   String?  @map("source_type")
  successCount Int      @default(0) @map("success_count")
  failCount    Int      @default(0) @map("fail_count")
  failDetails  String?  @map("fail_details") // JSON string
  importedBy   Int?     @map("imported_by")
  createdAt    DateTime @default(now()) @map("created_at")

  importedByUser User? @relation(fields: [importedBy], references: [id], onDelete: SetNull)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  externalAwardRecords ExternalAwardRecord[]
  classHonorRecords ClassHonorRecord[]

  @@map("import_logs")
}

model ExternalAwardRecord {
  id Int @id @default(autoincrement())
  academicYearId Int @map("academic_year_id")
  studentId Int @map("student_id")
  awardType String @map("award_type")
  awardName String @map("award_name")
  level String?
  sourceImportLogId Int? @map("source_import_log_id")
  createdAt DateTime @default(now()) @map("created_at")

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sourceImportLog ImportLog? @relation(fields: [sourceImportLogId], references: [id], onDelete: SetNull)

  @@unique([academicYearId, studentId, awardType])
  @@map("external_award_records")
}

model AwardQuota {
  id Int @id @default(autoincrement())
  academicYearId Int @map("academic_year_id")
  classId Int @map("class_id")
  quotaCount Int @default(0) @map("quota_count")
  availableAmount Float @default(0) @map("available_amount")
  remark String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, classId])
  @@map("award_quotas")
}

model ClassHonorRecord {
  id Int @id @default(autoincrement())
  academicYearId Int @map("academic_year_id")
  classId Int @map("class_id")
  honorType String @map("honor_type")
  sourceImportLogId Int? @map("source_import_log_id")
  createdAt DateTime @default(now()) @map("created_at")

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  sourceImportLog ImportLog? @relation(fields: [sourceImportLogId], references: [id], onDelete: SetNull)

  @@unique([academicYearId, classId, honorType])
  @@map("class_honor_records")
}

model DeclarationBatch {
  id Int @id @default(autoincrement())
  academicYearId Int @map("academic_year_id")
  classId Int @map("class_id")
  declarationType String @map("declaration_type")
  status String @default("draft")
  submittedBy Int? @map("submitted_by")
  submittedAt DateTime? @map("submitted_at")
  reviewedBy Int? @map("reviewed_by")
  reviewedAt DateTime? @map("reviewed_at")
  reviewOpinion String? @map("review_opinion")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  submittedByUser User? @relation("DeclarationSubmittedBy", fields: [submittedBy], references: [id], onDelete: SetNull)
  reviewedByUser User? @relation("DeclarationReviewedBy", fields: [reviewedBy], references: [id], onDelete: SetNull)
  students DeclarationStudent[]
  checklistItems DeclarationChecklistItem[]
  agreementSignatures AgreementSignature[]

  @@index([academicYearId, declarationType, status])
  @@map("declaration_batches")
}

model DeclarationStudent {
  id Int @id @default(autoincrement())
  batchId Int @map("batch_id")
  studentId Int @map("student_id")
  itemType String @map("item_type")
  itemLevel String? @map("item_level")
  amount Float?
  conditionSnapshotJson String @default("{}") @map("condition_snapshot_json")
  materialJson String @default("{}") @map("material_json")
  status String @default("pending")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  batch DeclarationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([batchId, studentId, itemType])
  @@map("declaration_students")
}

model DeclarationSupplement {
  id Int @id @default(autoincrement())
  academicYearId Int @map("academic_year_id")
  studentId Int @map("student_id")
  gender String?
  averageGpa Float? @map("average_gpa")
  disciplinaryAction String? @map("disciplinary_action")
  excellentStudentIntent Boolean? @map("excellent_student_intent")
  excellentStudentRecommendationLevel String? @map("excellent_student_recommendation_level")
  excellentCadreIntent Boolean? @map("excellent_cadre_intent")
  excellentCadreRecommendationSource String? @map("excellent_cadre_recommendation_source")
  excellentCadreRecommendationLevel String? @map("excellent_cadre_recommendation_level")
  positionInfo String? @map("position_info")
  competitionActivity String? @map("competition_activity")
  remark String?
  updatedBy Int? @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, studentId])
  @@map("declaration_supplements")
}

model DeclarationChecklistItem {
  id Int @id @default(autoincrement())
  batchId Int @map("batch_id")
  code String
  label String
  checked Boolean @default(false)
  checkedBy Int? @map("checked_by")
  checkedAt DateTime? @map("checked_at")

  batch DeclarationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  checkedByUser User? @relation("ChecklistCheckedBy", fields: [checkedBy], references: [id], onDelete: SetNull)

  @@unique([batchId, code])
  @@map("declaration_checklist_items")
}

model AgreementSignature {
  id Int @id @default(autoincrement())
  batchId Int @map("batch_id")
  agreementVersion Int @default(1) @map("agreement_version")
  signatureFileId Int? @map("signature_file_id")
  pdfFileId Int? @map("pdf_file_id")
  signedBy Int? @map("signed_by")
  signedAt DateTime? @map("signed_at")

  batch DeclarationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  signatureFile SignatureFile? @relation(fields: [signatureFileId], references: [id], onDelete: SetNull)
  pdfFile PdfFile? @relation(fields: [pdfFileId], references: [id], onDelete: SetNull)
  signedByUser User? @relation("AgreementSignedBy", fields: [signedBy], references: [id], onDelete: SetNull)

  @@map("agreement_signatures")
}

model ScoreReviewRecord {
  id Int @id @default(autoincrement())
  academicYearId Int @map("academic_year_id")
  classId Int @map("class_id")
  status String @default("draft")
  pdfFileId Int? @map("pdf_file_id")
  completedAt DateTime? @map("completed_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  pdfFile PdfFile? @relation(fields: [pdfFileId], references: [id], onDelete: SetNull)
  members ScoreReviewGroupMember[]
  invites ScoreReviewMemberInvite[]
  studentChecks ScoreReviewStudentCheck[]

  @@unique([academicYearId, classId])
  @@map("score_review_records")
}

model ScoreReviewGroupMember {
  id Int @id @default(autoincrement())
  recordId Int @map("record_id")
  name String
  roleName String? @map("role_name")
  sortOrder Int @default(0) @map("sort_order")
  signatureFileId Int? @map("signature_file_id")
  signedAt DateTime? @map("signed_at")

  record ScoreReviewRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  signatureFile SignatureFile? @relation(fields: [signatureFileId], references: [id], onDelete: SetNull)
  invites ScoreReviewMemberInvite[]
  studentChecks ScoreReviewStudentCheck[]

  @@map("score_review_group_members")
}

model ScoreReviewMemberInvite {
  id Int @id @default(autoincrement())
  recordId Int @map("record_id")
  memberId Int @map("member_id")
  reviewerUserId Int? @map("reviewer_user_id")
  tokenHash String @unique @map("token_hash")
  deviceIdHash String? @map("device_id_hash")
  deviceBoundAt DateTime? @map("device_bound_at")
  status String @default("active")
  expiresAt DateTime @map("expires_at")
  lastLoginAt DateTime? @map("last_login_at")
  createdBy Int? @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  record ScoreReviewRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  member ScoreReviewGroupMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  reviewerUser User? @relation("ScoreReviewInviteReviewer", fields: [reviewerUserId], references: [id], onDelete: SetNull)
  createdByUser User? @relation("ScoreReviewInviteCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([recordId])
  @@index([memberId])
  @@index([reviewerUserId])
  @@map("score_review_member_invites")
}

model ScoreReviewStudentCheck {
  id Int @id @default(autoincrement())
  recordId Int @map("record_id")
  memberId Int @map("member_id")
  studentId Int @map("student_id")
  status String @default("pending")
  remark String?
  checkedAt DateTime? @map("checked_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  record ScoreReviewRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  member ScoreReviewGroupMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([recordId, memberId, studentId])
  @@index([recordId])
  @@index([studentId])
  @@map("score_review_student_checks")
}

model StoredFile {
  id Int @id @default(autoincrement())
  fileName String @map("file_name")
  fileType String @map("file_type")
  mimeType String @map("mime_type")
  storageKey String @unique @map("storage_key")
  sha256 String
  size Int
  createdBy Int? @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  createdByUser User? @relation("StoredFileCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  originalSignatureFiles SignatureFile[] @relation("OriginalSignatureFile")
  croppedSignatureFiles SignatureFile[] @relation("CroppedSignatureFile")
  pdfFiles PdfFile[]

  @@map("stored_files")
}

model SignatureFile {
  id Int @id @default(autoincrement())
  signerName String @map("signer_name")
  method String
  purpose String
  originalFileId Int? @map("original_file_id")
  croppedFileId Int? @map("cropped_file_id")
  createdBy Int? @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  originalFile StoredFile? @relation("OriginalSignatureFile", fields: [originalFileId], references: [id], onDelete: SetNull)
  croppedFile StoredFile? @relation("CroppedSignatureFile", fields: [croppedFileId], references: [id], onDelete: SetNull)
  createdByUser User? @relation("SignatureFileCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  agreementSignatures AgreementSignature[]
  scoreReviewGroupMembers ScoreReviewGroupMember[]

  @@map("signature_files")
}

model PdfFile {
  id Int @id @default(autoincrement())
  storedFileId Int @map("stored_file_id")
  pdfType String @map("pdf_type")
  templateVersion Int @default(1) @map("template_version")
  businessType String @map("business_type")
  businessId Int @map("business_id")
  generatedBy Int? @map("generated_by")
  generatedAt DateTime @default(now()) @map("generated_at")

  storedFile StoredFile @relation(fields: [storedFileId], references: [id], onDelete: Cascade)
  generatedByUser User? @relation("PdfGeneratedBy", fields: [generatedBy], references: [id], onDelete: SetNull)
  agreementSignatures AgreementSignature[]
  scoreReviewRecords ScoreReviewRecord[]

  @@index([businessType, businessId])
  @@map("pdf_files")
}

model Tag {
  id Int @id @default(autoincrement())
  academicYearId Int @map("academic_year_id")
  studentId Int? @map("student_id")
  classId Int? @map("class_id")
  tagType String @map("tag_type")
  tagName String @map("tag_name")
  sourceType String @map("source_type")
  sourceId Int? @map("source_id")
  createdAt DateTime @default(now()) @map("created_at")

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class Class? @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([academicYearId, tagType])
  @@map("tags")
}

model AuditLog {
  id Int @id @default(autoincrement())
  module String
  action String
  academicYearId Int? @map("academic_year_id")
  classId Int? @map("class_id")
  actorId Int? @map("actor_id")
  targetType String? @map("target_type")
  targetId Int? @map("target_id")
  beforeJson String? @map("before_json")
  afterJson String? @map("after_json")
  createdAt DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([module, action, createdAt])
  @@index([academicYearId, classId])
  @@map("audit_logs")
}

model MailConfig {
  id Int @id @default(autoincrement())
  smtpHost String @map("smtp_host")
  smtpPort Int @map("smtp_port")
  username String
  passwordEncrypted String @map("password_encrypted")
  senderName String @map("sender_name")
  enabled Boolean @default(false)
  updatedBy Int? @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  updatedByUser User? @relation("MailConfigUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("mail_configs")
}

model MailTemplate {
  id Int @id @default(autoincrement())
  templateType String @map("template_type")
  subject String
  body String
  variablesJson String @default("[]") @map("variables_json")
  version Int @default(1)
  enabled Boolean @default(true)
  updatedBy Int? @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  updatedByUser User? @relation("MailTemplateUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@unique([templateType, version])
  @@map("mail_templates")
}

model MailLog {
  id Int @id @default(autoincrement())
  templateType String @map("template_type")
  recipientEmail String @map("recipient_email")
  subject String
  contentDigest String? @map("content_digest")
  variablesJson String? @map("variables_json")
  status String @default("pending")
  failureReason String? @map("failure_reason")
  sentBy Int? @map("sent_by")
  sentAt DateTime? @map("sent_at")
  createdAt DateTime @default(now()) @map("created_at")

  sentByUser User? @relation("MailLogSentBy", fields: [sentBy], references: [id], onDelete: SetNull)

  @@index([templateType, status, createdAt])
  @@map("mail_logs")
}

model SystemSetting {
  id Int @id @default(autoincrement())
  key String @unique
  valueJson String @map("value_json")
  updatedBy Int? @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// 国家奖学金评定（PDF《关于国家奖学金评定办法的完善方案》附录 A 四算法）——纯增量模块
model NationalScholarshipEvaluation {
  id             Int      @id @default(autoincrement())
  academicYearId Int      @map("academic_year_id")
  name           String                                  // 评比单元名称，如"2023级计算机科学与技术（合组）"
  classIdsJson   String   @map("class_ids_json")          // JSON number[]：参与合组的班级
  quota          Int      @default(0)                     // Q 下达名额
  poolRatio      Float    @default(0.1) @map("pool_ratio")// p 入池比例
  paramW         Float    @default(0.5) @map("param_w")   // 按班授课学分占比
  paramD         Float    @default(1.0) @map("param_d")   // 单科给分松紧折算绩点的最大差异
  analyticB      Float?   @map("analytic_b")              // B_解析 = w·d
  empiricalB     Float?   @map("empirical_b")             // B_经验 = median|Δ(q)|
  effectiveB     Float?   @map("effective_b")             // B = min
  status         String   @default("draft")               // draft | computed | finalized
  note           String?
  createdBy      Int?     @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  academicYear AcademicYear                   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  candidates   NationalScholarshipCandidate[]

  @@index([academicYearId])
  @@map("national_scholarship_evaluations")
}

model NationalScholarshipCandidate {
  id                  Int      @id @default(autoincrement())
  evaluationId        Int      @map("evaluation_id")
  studentId           Int      @map("student_id")
  classId             Int      @map("class_id")
  gpa                 Float                                  // g 快照：academic/8 − 2.5
  totalScore          Float    @map("total_score")          // z 快照：综测总分
  gRank               Int      @map("g_rank")               // 专业绩点名次（并列同名次）
  zRank               Int      @map("z_rank")               // 专业综测名次
  isClassRecommended  Boolean  @default(false) @map("is_class_recommended") // L_i
  hasMajorAchievement Boolean  @default(false) @map("has_major_achievement")// M_i
  inPool              Boolean  @default(false) @map("in_pool")
  poolReasonsJson     String   @default("[]") @map("pool_reasons_json")     // JSON string[]：入池来源
  dominatedByCount    Int      @default(0) @map("dominated_by_count")       // 被多少人稳健占优
  robustRank          Int?     @map("robust_rank")          // 稳健层名次 = 被占优数 + 1
  isCritical          Boolean  @default(false) @map("is_critical")          // 临界层
  achievements        String?                                // 主要成果清单（人工）
  reviewNote          String?  @map("review_note")           // 临界比较记录 / 书面理由（留痕）
  finalRank           Int?     @map("final_rank")
  selected            Boolean  @default(false)               // 是否入选推荐名单
  updatedAt           DateTime @updatedAt @map("updated_at")

  evaluation NationalScholarshipEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  student    Student                       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, studentId])
  @@index([evaluationId])
  @@index([studentId])
  @@map("national_scholarship_candidates")
}
